# Upstash Redis via Vercel Marketplace (server only; never put these in HTML/JS).
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# Marketplace installations with KV_* names are supported as aliases:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Generate independent random secrets with at least 32 characters.
LOG_CURSOR_SECRET=
# Separate operator key for the dashboard Start/Stop button (32-256 printable characters).
# Never reuse an ingest key. The browser only sends a key manually entered by the operator.
LOG_CONTROL_KEY=
# Replace placeholder tokens and device IDs before use; no wildcard device access.
INGEST_SOURCES={"broker-main":{"token":"REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS","devices":["server-01"],"source":"device"},"demo-source":{"token":"REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET","devices":["demo-01"],"source":"simulation"}}
LOG_RETENTION_DAYS=7
INGEST_RATE_LIMIT_PER_MINUTE=120

# Optional: existing cloud settings feature still uses its own Redis connection.
# Do not use this URL in the frontend. Logging uses the REST variables above.
# REDIS_URL=rediss://default:PASSWORD@HOST:PORT
